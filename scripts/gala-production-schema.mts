// Offline packaging only. This script never connects to or applies SQL to a database.
import { readFile, writeFile } from 'node:fs/promises';
import { createHash } from 'node:crypto';
import { fileURLToPath } from 'node:url';
import { resolve } from 'node:path';

const root = new URL('../', import.meta.url);
const sources = [
  '001_gala_backend.sql', '002_gala_accounting.sql', '003_gala_assignments.sql',
  '004_gala_gifts.sql', '005_gala_invitations.sql', '006_gala_invitation_addresses.sql',
  '007_gala_invitation_duplicates.sql', '008_gala_payment_recovery.sql', '009_gala_access.sql',
  '010_gala_login_limits.sql', '011_gala_cart.sql', '012_gala_ledger.sql',
  '013_gala_final_total.sql', '014_gala_unlimited_manual_accounting.sql',
];
const output = new URL('supabase/gala-production/001_initial.sql', root);
const normalize = (text: string) => text.replace(/\r\n/g, '\n');

export async function productionSchema() {
  const chunks: string[] = [];
  let sessionGuards = 0;
  for (const file of sources) {
    const original = normalize(await readFile(new URL(`supabase/gala-development/${file}`, root), 'utf8'));
    // Only the reviewed, explicit source sequence is packaged, not arbitrary
    // future files, scheduler configuration, dumps, fixtures or local secrets.
    if ((original.match(/^begin;\s*$/gm) || []).length !== 1 || (original.match(/^commit;\s*$/gm) || []).length !== 1)
      throw new Error(`Review transaction boundaries in ${file}`);
    const hash = createHash('sha256').update(original).digest('hex');
    sessionGuards += (original.match(/p_session not like 'cs_test_%'/g) || []).length;
    const sql = original.replace(/^begin;\s*$/gm, '').replace(/^commit;\s*$/gm, '')
      .replace(/^--[^\n]*(?:DEVELOPMENT|development project|Apply only to the empty)[^\n]*\n/gm, '')
      .replaceAll('osg-gala-development', 'osg-gala-production')
      .replaceAll('Gala development', 'Gala production')
      .replaceAll('Development marker required', 'Production marker required')
      .replaceAll('Development environment required', 'Production environment required')
      .replaceAll('local-development-admin', 'shared-admin')
      .replaceAll("p_session not like 'cs_test_%'", () => "p_session !~ '^cs_live_[A-Za-z0-9]+$'")
      .replaceAll('Test session required', 'Live session required');
    if (sql.includes('cs_test_') || sql.includes('osg-gala-development')) throw new Error(`Unreviewed test identity in ${file}`);
    chunks.push(`-- Source: ${file}; normalized SHA-256: ${hash}\n${sql.trim()}`);
  }
  if (sessionGuards !== 3) throw new Error('Payment session guards changed; review the production conversion.');
  const safeguards = normalize(await readFile(new URL('supabase/gala-production/production-safeguards.sql', root), 'utf8'));
  return `-- GENERATED by scripts/gala-production-schema.mts. Do not edit this file by hand.
-- PREPARED ONLY: not authorization to apply or open sales.
-- Fresh, dedicated Gala production project only. Refuses nonempty public schemas.
-- One transaction: intermediate historical grants/stock are never published.
-- No test records, credentials, named staff, scheduler or membership data are copied.
begin;
-- Serialize installation and refuse existing application relations, including
-- views/sequences that would not be caught by the historical table-only check.
select pg_advisory_xact_lock(hashtextextended('osg-gala-production-install',0));
do $$ begin
  if exists(select 1 from pg_class where relnamespace='public'::regnamespace and relkind in ('r','p','v','m','S','f')) then
    raise exception 'Refusing to initialize Gala production in a nonempty public schema';
  end if;
end $$;
${chunks.join('\n\n')}

${safeguards.trim()}
commit;
`;
}

async function main() {
  const sql = await productionSchema();
  if (process.argv.length !== 3 || !['--write', '--check'].includes(process.argv[2]))
    throw new Error('Use --write to prepare the SQL file or --check to verify it. Neither applies SQL.');
  if (process.argv[2] === '--write') {
    await writeFile(output, sql);
    console.log('Prepared supabase/gala-production/001_initial.sql. Nothing applied.');
  } else {
    if (normalize(await readFile(output, 'utf8')) !== sql) throw new Error('Production SQL differs from reviewed sources; regenerate and re-test.');
    console.log('Production SQL matches its reviewed source sequence. Nothing applied.');
  }
}
if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url))
  main().catch(error => { console.error(error.message); process.exitCode = 1; });
