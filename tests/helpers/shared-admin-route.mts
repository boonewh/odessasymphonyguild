const key='a'.repeat(64),password='FictionalTestPass';
Object.assign(process.env,{NODE_ENV:'production',VERCEL:'1',VERCEL_ENV:'preview',VERCEL_PROJECT_ID:BOARD_PROJECT,VERCEL_GIT_COMMIT_REF:BOARD_BRANCH,GALA_BOARD_ORIGIN:BOARD_ORIGIN,GALA_BOARD_REVIEW:'true',GALA_BACKEND_ENABLED:'true',GALA_ACCESS_MODE:'development',GALA_BOARD_ACCESS_CODE:password,GALA_DEVELOPMENT_TOKEN:key,GALA_STRIPE_SECRET_KEY:'sk_test_fake',GALA_STRIPE_WEBHOOK_SECRET:'whsec_fake',GALA_SUPABASE_URL:DEVELOPMENT_SUPABASE_URL,GALA_SUPABASE_SECRET_KEY:'sb_secret_fake'});
